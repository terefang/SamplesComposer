# syntax=docker/dockerfile:1
FROM {{ DOCKERIMAGE }}

ENV DEBIAN_FRONTEND=noninteractive
ENV GO_VERSION=1.26.7
ENV PATH="/usr/local/go/bin:${PATH}"

RUN dnf -y --setopt=tsflags=nodocs install \
        ca-certificates \
        curl \
        gcc \
        g++ \
        pkg-config \
        patchelf \
        wayland-devel \
        mesa-libGL-devel \
        mesa-libEGL-devel \
        libxkbcommon-devel \
        libX11-devel \
        libXcursor-devel \
        libXrandr-devel \
        libXinerama-devel \
        libXi-devel \
        libXxf86vm-devel
# Install a modern Go toolchain
RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" | tar -C /usr/local -xzf -


WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download


COPY . .
RUN rm -rf vendor && go mod tidy && go mod vendor

#build
ENV CGO_ENABLED=1 GOOS=linux
RUN ls -la && pwd && go build -v -trimpath -o /out/fyne-app ./cmd/sc

FROM scratch
COPY --from=0 /out/fyne-app /fyne-app
ENTRYPOINT ["/fyne-app"]