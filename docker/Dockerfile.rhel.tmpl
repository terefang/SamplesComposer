# syntax=docker/dockerfile:1
FROM {{ DOCKERIMAGE }}

ENV DEBIAN_FRONTEND=noninteractive
ENV GO_VERSION=1.26.7
ENV PATH="/usr/local/go/bin:${PATH}"

RUN dnf -y --setopt=tsflags=nodocs install dnf-plugins-core \
        && dnf config-manager --set-enabled crb \
        && dnf -y --skip-broken --setopt=tsflags=nodocs install \
            ca-certificates \
            gcc \
            gcc-c++ \
            pkg-config \
            wayland-devel \
            mesa-libGL-devel \
            mesa-libEGL-devel \
            libxkbcommon-devel \
            libX11-devel \
            libXcursor-devel \
            libXrandr-devel \
            libXinerama-devel \
            libXi-devel \
            libXxf86vm-devel \
        && dnf clean all

