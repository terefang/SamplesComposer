# syntax=docker/dockerfile:1
FROM {{ DOCKERIMAGE }}

ENV DEBIAN_FRONTEND=noninteractive
ENV GO_VERSION=1.26.7
ENV PATH="/usr/local/go/bin:${PATH}"

RUN pacman -Syu --noconfirm --needed \
            ca-certificates \
            curl \
            gcc \
            pkgconf \
            patchelf \
            wayland \
            libglvnd \
            libxkbcommon \
            libx11 \
            libxcursor \
            libxrandr \
            libxinerama \
            libxi \
            libxxf86vm

